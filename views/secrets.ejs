<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secrets</title>
</head>
<body>
    <h1>Secrets</h1>
    <% if (usersWithSecrets.length > 0) { %>
        <ul>
            <% usersWithSecrets.forEach(function(user) { %>
                <li><%= user.secret %> - <%= user.username || user.email %></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No secrets to display.</p>
    <% } %>
</body>
</html>